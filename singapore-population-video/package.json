{
  "name": "singapore-population-video",
  "version": "1.0.0",
  "private": true,
  "description": "20-second Remotion video: Singapore's population on the road to 2050",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render SingaporePopulation2050 out/singapore-population-2050.mp4",
    "still": "remotion still SingaporePopulation2050 out/poster.png --frame=560",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "^4.0.540",
    "@remotion/transitions": "^4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
